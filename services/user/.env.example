ENV_TYPE=dev
NODE_ENV=development
PORT=4001
LOG_LEVEL=info
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=user-service
DATABASE_URL=postgresql://user:password@localhost:5432/topos_user
DATABASE_URL_MIGRATE=postgresql://user:password@localhost:5432/topos_user

# Docker dev — hardcoded network/ports, overridable host ports for collisions
# APP_NETWORK is topos_local_network (hardcoded in compose); container names are
# auto-generated via project name. Host ports below remain overridable.
USER_SERVICE_EXT_PORT=4001
USER_JWT_SECRET=local-dev-secret-0123456789abcdef0123456789abcdef
USER_POSTGRES_EXT_PORT=5432
USER_DATABASE_URL=postgresql://topos_user:topos_pass@user-postgres:5432/topos_users
USER_DATABASE_URL_MIGRATE=postgresql://topos_user:topos_pass@user-postgres:5432/topos_users
# App-pool tuning (SSM /topos/user/config in prod). Bounds keep
# tasks x pool_max within the RDS Proxy budget on a micro instance.
# Prod DATABASE_URL (proxy) and DATABASE_URL_MIGRATE (direct writer) both
# need ?sslmode=require; the migrate URL must never use a pooler.
USER_PG_POOL_MAX=10
USER_PG_POOL_IDLE_TIMEOUT_MS=30000
USER_PG_POOL_CONNECTION_TIMEOUT_MS=5000

REDIS_URL=redis://user-redis:6379
USER_REDIS_URL=redis://user-redis:6379
USER_REDIS_EXT_PORT=6380
REDIS_CACHE_TTL_MS=3600000
REDIS_MISSING_CACHE_TTL_MS=60000
# Rate limiting quotas (per minute over RATELIMIT_WINDOW_SECONDS; keys expire).
# Signup/signin stay strict: they guard bcrypt and brute-force abuse.
RATELIMIT_ENABLED=true
RATELIMIT_SIGNUP_PER_MIN=5
RATELIMIT_SIGNIN_PER_MIN=10
RATELIMIT_MUTATIONS_PER_MIN=30
RATELIMIT_READS_PER_MIN=120
RATELIMIT_WINDOW_SECONDS=60
# Memory fallback while Redis is unreachable: ordinary quotas scale by
# RATELIMIT_DEGRADED_MULTIPLIER, auth keeps RATELIMIT_AUTH_DEGRADED_MULTIPLIER.
RATELIMIT_DEGRADED_MULTIPLIER=2
RATELIMIT_AUTH_DEGRADED_MULTIPLIER=1
RATELIMIT_AUTH_CONCURRENCY=5
RATELIMIT_REDIS_TIMEOUT_MS=150
RATELIMIT_MEMORY_MAX_ENTRIES=10000
