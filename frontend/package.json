{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:mock": "VITE_ENABLE_MOCKS=true VITE_GRAPHQL_URL=http://localhost:4000/graphql VITE_CLOUDINARY_CLOUD_NAME=mock VITE_CLOUDINARY_UPLOAD_PRESET=mock vite",
    "dev:preview": "VITE_ENV_TYPE=preview VITE_GRAPHQL_URL=http://localhost:4000/graphql VITE_CLOUDINARY_CLOUD_NAME=mock VITE_CLOUDINARY_UPLOAD_PRESET=mock vite",
    "codegen": "graphql-codegen --config codegen.ts",
    "build": "npm run codegen && tsc -b && vite build",
    "build:preview": "VITE_ENV_TYPE=preview npm run build",
    "build:prod": "VITE_ENV_TYPE=prod npm run build",
    "lint": "eslint .",
    "preview": "vite preview",
    "serve": "vite preview",
    "test": "vitest run --exclude='**/*.integration.test.{ts,tsx}'",
    "test:watch": "vitest --exclude='**/*.integration.test.{ts,tsx}'",
    "test:coverage": "vitest run --coverage --exclude='**/*.integration.test.{ts,tsx}'",
    "test:integration": "vitest run --reporter=verbose \"integration\""
  },
  "dependencies": {
    "@apollo/client": "^4.1.6",
    "@hookform/resolvers": "^5.2.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "dompurify": "^3.2.6",
    "graphql": "^16.13.1",
    "lucide-react": "^0.454.0",
    "radix-ui": "^1.4.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.71.2",
    "react-quill-new": "3.7.0",
    "react-router-dom": "^6.26.1",
    "sonner": "^1.5.0",
    "tailwind-merge": "^2.6.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.3.6",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "@graphql-codegen/cli": "^6.1.3",
    "@graphql-codegen/client-preset": "^5.2.4",
    "@tailwindcss/typography": "^0.5.16",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/dompurify": "^3.0.5",
    "@types/node": "^22.5.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "@vitest/coverage-v8": "^4.1.8",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.9.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.9",
    "globals": "^15.9.0",
    "jsdom": "^26.1.0",
    "msw": "^2.12.10",
    "postcss": "^8.4.41",
    "shadcn": "^4.0.5",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.0.1",
    "vite": "^6.3.5",
    "vitest": "^4.0.18"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
