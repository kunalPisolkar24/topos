VITE_ENV_TYPE="dev"
VITE_GRAPHQL_URL="http://localhost:4000/graphql"
VITE_BACKEND_URL="http://localhost:4000"

# preview = full IndexedDB mock (any password works, picsum images, uploads disabled, AI simulated)
# dev     = real backend at VITE_GRAPHQL_URL (use npm run dev:mock for in-memory mock)
# prod    = strict prod, mocks never start even if VITE_ENABLE_MOCKS=true
VITE_ENABLE_MOCKS="false"

# Any dummy values work in mock/preview mode: uploads are intercepted by MSW and
# replaced with random placeholder images. Set real values for production.
VITE_CLOUDINARY_CLOUD_NAME="mock"
VITE_CLOUDINARY_UPLOAD_PRESET="mock"
