VITE_ENV_TYPE=dev
VITE_GRAPHQL_URL=http://localhost:4000/graphql
VITE_BACKEND_URL=http://localhost:4000
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
VITE_ENABLE_MOCKS=
FRONTEND_CONTAINER=local-frontend
FRONTEND_INT_PORT=3000
FRONTEND_EXT_PORT=3000
APP_NETWORK=topos_local_network

# Single image: same build serves dev/preview/prod via runtime /config.js.
# - dev/preview: values above (compose + .env), no AWS call.
# - prod: use `make compose-up-prod` — fetches SSM /topos/frontend/config
#   (+ optional SM topos/frontend/secrets) into .env.aws (gitignored).
# AWS_ENDPOINT_URL=http://localhost:4566
# AWS_REGION=ap-south-1
