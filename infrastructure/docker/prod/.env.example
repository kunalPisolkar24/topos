# Topos prod env. Copy to .env: cp .env.example .env, then fill CHANGEME from `terraform output`.
# Empty value = disabled/optional. USER_JWT_SECRET and CONTENT_JWT_SECRET must match.

# Network (external; create once: docker network create floci-apps, then attach floci + sidecars)
APP_NETWORK=floci-apps

# AWS (Floci emulator; empty AWS_ENDPOINT_URL for real AWS)
AWS_ENDPOINT_URL=http://localhost:4566
AWS_REGION=ap-south-1

# User (Floci RDS :7001 + ElastiCache :6379; passwords from terraform output)
ENV_TYPE=prod
USER_SERVICE_EXT_PORT=4001
USER_LOG_LEVEL=info
USER_JWT_SECRET=CHANGEME-match-content-jwt
USER_DATABASE_URL=postgresql://topos_user:CHANGEME@floci:7001/topos_users
USER_DATABASE_URL_MIGRATE=postgresql://topos_user:CHANGEME@floci:7001/topos_users
USER_PG_POOL_MAX=10
USER_PG_POOL_IDLE_TIMEOUT_MS=30000
USER_PG_POOL_CONNECTION_TIMEOUT_MS=5000
USER_REDIS_URL=redis://:CHANGEME@floci:6379
USER_AI_CHECKPOINTER_PASSWORD=CHANGEME-ai-checkpointer-pw
USER_CACHE_TTL_MS=3600000
USER_MISSING_CACHE_TTL_MS=60000

# Content (Floci DocDB/MSK sidecars on floci-apps; KAFKA_BROKERS changes on cluster recreate)
CONTENT_SERVICE_INT_PORT=4002
CONTENT_SERVICE_EXT_PORT=4002
CONTENT_WORKER_INT_PORT=4003
CONTENT_MONGO_URI=mongodb://topos_content:CHANGEME@floci-docdb-topos-content-floci-docdb:27017/blog_content?authSource=admin
CONTENT_DB_NAME=blog_content
CONTENT_JWT_SECRET=CHANGEME-match-user-jwt
CONTENT_INTERNAL_TOKEN=CHANGEME-internal-token
CONTENT_REDIS_ADDR=floci:6379
REDIS_PASSWORD=CHANGEME-redis-auth-token
KAFKA_BROKERS=floci-msk-6eb9bc:9092
KAFKA_TOPIC=posts
KAFKA_USER_INTERACTED_TOPIC=user-interacted
KAFKA_DLQ_TOPIC=posts-dlq
KAFKA_CONSUMER_GROUP_ID=content-summary-worker-group
WORKER_CONCURRENCY=3

# AI LLM (real mode needs LIGHTNING_AI_API_KEY)
AI_SERVICE_INT_PORT=50051
AI_SERVICE_EXT_PORT=50051
AI_METRICS_INT_PORT=12666
AI_METRICS_EXT_PORT=12666
AI_LLM_MODE=real
AI_LOG_LEVEL=INFO
AI_TIMEOUT_SECONDS=30
LIGHTNING_AI_API_KEY=
AI_LIGHTNING_MODEL=openai/gpt-5-nano
AI_LANGCHAIN_TRACING=false
AI_LANGCHAIN_API_KEY=
AI_LANGCHAIN_PROJECT=topos-ai

# AI search (Qdrant Cloud server-side inference; no EMBEDDING_URL needed)
AI_VECTOR_MODE=qdrant
AI_EMBEDDING_MODE=inference
AI_QDRANT_URL=https://7f3d5d9e-73fe-4fc4-9fe6-1e818a6fc0bd.us-west-2-0.aws.cloud.qdrant.io
AI_QDRANT_API_KEY=
AI_EMBEDDING_MODEL=sentence-transformers/all-minilm-l6-v2
AI_QDRANT_VECTOR_SIZE=384
AI_SEARCH_DENSE_SCORE_THRESHOLD=0.3

# AI checkpoint (shared RDS instance, ai_checkpoints db; password from terraform output)
AI_CHECKPOINT_DB_URL=postgresql://ai_checkpointer:CHANGEME@floci:7001/ai_checkpoints
AI_CHECKPOINT_DB_URL_MIGRATE=postgresql://ai_checkpointer:CHANGEME@floci:7001/ai_checkpoints
AI_CHECKPOINT_POOL_MIN_SIZE=1
AI_CHECKPOINT_POOL_MAX_SIZE=10

# Observability (empty endpoint = tracing disabled)
OTEL_EXPORTER_OTLP_ENDPOINT=
LOG_LEVEL=info
LOG_FORMAT=json

# Gateway
GATEWAY_CONTAINER=prod-gateway
GATEWAY_INT_PORT=4000
GATEWAY_EXT_PORT=4000

# Frontend (prod must be prod; runtime /config.js serves these without rebuild)
FRONTEND_CONTAINER=prod-frontend
FRONTEND_INT_PORT=3000
FRONTEND_EXT_PORT=3000
VITE_ENV_TYPE=prod
VITE_GRAPHQL_URL=https://your-domain.com/graphql
VITE_BACKEND_URL=https://your-domain.com
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
VITE_ENABLE_MOCKS=false

# Content dials AI over gRPC on floci-apps
AI_SERVICE_URL=ai-service:50051
