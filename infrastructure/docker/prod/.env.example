# =============================================================================
# Topos — Production Environment Example (Frontend-only)
# =============================================================================
# Copy this file to `.env` at the repo root and fill in real values:
#   cp infrastructure/docker/prod/.env.example .env
#
# Frontend build-time vars (VITE_*) are baked into the static bundle at
# `docker build` via `ARG → vite build` (public, visible in browser).
# Backend secrets (JWT, DB passwords, API keys, etc.) are now managed in
# AWS — SSM Parameter Store for config (String) and Secrets Manager for
# secrets. Use `tools/seed-secrets` to seed Floci/LocalStack at
# http://localhost:4566 for local testing:
#   cd tools/seed-secrets && make dry-run && make seed-floci
#
# This file is consumed by `make` / `docker compose` via `--env-file .env`.
# Vars without defaults MUST be set; vars with defaults may be omitted.
# =============================================================================

# --- Network ----------------------------------------------------------------
APP_NETWORK=topos_network

# --- Frontend — VITE build-time vars (baked into static bundle) --------------
# VITE_ENV_TYPE: preview|dev|prod. Prod must be prod; do not use preview in prod.
VITE_ENV_TYPE=prod
VITE_GRAPHQL_URL=https://your-domain.com/graphql
VITE_BACKEND_URL=https://your-domain.com
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
# Optional legacy mock toggle (ignored when VITE_ENV_TYPE=prod via shouldEnableMocks guard)
VITE_ENABLE_MOCKS=false

# Docker container / host ports for the nginx frontend
FRONTEND_CONTAINER=prod-frontend
FRONTEND_INT_PORT=5173
FRONTEND_EXT_PORT=3000

# --- Gateway (frontend talks to this) ---------------------------------------
GATEWAY_CONTAINER=prod-gateway
GATEWAY_INT_PORT=4000
GATEWAY_EXT_PORT=4000

# --- AWS (seed-secrets tool) ------------------------------------------------
# Floci/LocalStack endpoint for local testing; omit/empty for real AWS.
# Region for both SM and SSM (Floci defaults to ap-south-1).
AWS_ENDPOINT_URL=http://localhost:4566
AWS_REGION=ap-south-1
# SSM param for frontend (JSON blob with VITE_* etc.)
# Backend secrets (topos/user, topos/ai, …) will be added gradually.
# SSM: /topos/frontend/config  (String, JSON)
# SM:  (future) topos/user/secrets, topos/content/secrets, topos/ai/secrets

# --- Backend secrets: managed in AWS (not in this file) ---------------------
# Previously here: KAFKA_*, QDRANT_*, AI_*, USER_*, CONTENT_*, etc.
# They are now seeded to SM/SSM and injected at deploy/runtime.
# See tools/seed-secrets/src/domain/constants.py and docs/components/secrets-mapping.md
# for full key mapping. For local dev without AWS, use infrastructure/docker/local/.env.local.example
