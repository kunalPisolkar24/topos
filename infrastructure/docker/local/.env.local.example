# Topos local env. Copy to .env.local: cp .env.local.example .env.local
# Empty value = disabled/optional. USER_JWT_SECRET and CONTENT_JWT_SECRET must match.

# Network
APP_NETWORK=topos_local_network

# Kafka
KAFKA_INT_PORT=9092
KAFKA_EXT_PORT=9092
KAFKA_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk
KAFKA_TOPIC=posts
KAFKA_BROKERS=kafka-1:9092
KAFKA_UI_EXT_PORT=8080
KAFKA_UI_INT_PORT=8080

# Content (docker mongo/kafka + shared user-redis)
CONTENT_SERVICE_CONTAINER=local-content-service
CONTENT_SERVICE_INT_PORT=4002
CONTENT_SERVICE_EXT_PORT=4002
CONTENT_WORKER_CONTAINER=local-content-worker
CONTENT_WORKER_INT_PORT=4012
CONTENT_WORKER_EXT_PORT=4012
CONTENT_PERSONALIZER_CONTAINER=local-content-personalizer
CONTENT_PERSONALIZER_INT_PORT=4005
CONTENT_PERSONALIZER_EXT_PORT=4005
CONTENT_MONGO_URI=mongodb://content-mongo:27017
CONTENT_MONGO_INT_PORT=27017
CONTENT_MONGO_EXT_PORT=27017
CONTENT_DB_NAME=blog_content
CONTENT_JWT_SECRET=local-dev-secret-0123456789abcdef0123456789abcdef
CONTENT_INTERNAL_TOKEN=local-internal-secret
CONTENT_REDIS_ADDR=user-redis:6379
CONTENT_REDIS_EXT_PORT=6379
# Rate limiting quotas (per minute, shared user-redis; see services/content/.env.example)
RATELIMIT_ENABLED=true
RATELIMIT_READS_PER_MIN=120
RATELIMIT_MUTATIONS_PER_MIN=30
RATELIMIT_INTERACTIONS_PER_MIN=60
RATELIMIT_SEARCH_PER_MIN=30
RATELIMIT_AI_PER_MIN=10
RATELIMIT_WINDOW_SECONDS=60
RATELIMIT_DEGRADED_MULTIPLIER=2
RATELIMIT_AI_DEGRADED_MULTIPLIER=1
RATELIMIT_AI_CONCURRENCY=5
RATELIMIT_REDIS_TIMEOUT_MS=150
RATELIMIT_MEMORY_MAX_ENTRIES=10000

# User (docker postgres/redis, ENV_TYPE=dev makes zero AWS calls)
ENV_TYPE=dev
USER_SERVICE_EXT_PORT=4001
USER_LOG_LEVEL=info
USER_OTLP_ENDPOINT=
USER_JWT_SECRET=local-dev-secret-0123456789abcdef0123456789abcdef
USER_POSTGRES_EXT_PORT=5432
USER_DATABASE_URL=postgresql://topos_user:topos_pass@user-postgres:5432/topos_users
USER_DATABASE_URL_MIGRATE=postgresql://topos_user:topos_pass@user-postgres:5432/topos_users
USER_PG_POOL_MAX=10
USER_PG_POOL_IDLE_TIMEOUT_MS=30000
USER_PG_POOL_CONNECTION_TIMEOUT_MS=5000
USER_REDIS_URL=redis://user-redis:6379
USER_REDIS_EXT_PORT=6380
USER_CACHE_TTL_MS=3600000
USER_MISSING_CACHE_TTL_MS=60000
# Rate limiting quotas (per minute; signup/signin stay strict)
USER_RATELIMIT_ENABLED=true
USER_RATELIMIT_SIGNUP_PER_MIN=5
USER_RATELIMIT_SIGNIN_PER_MIN=10
USER_RATELIMIT_MUTATIONS_PER_MIN=30
USER_RATELIMIT_READS_PER_MIN=120
USER_RATELIMIT_WINDOW_SECONDS=60
USER_RATELIMIT_DEGRADED_MULTIPLIER=2
USER_RATELIMIT_AUTH_DEGRADED_MULTIPLIER=1
USER_RATELIMIT_AUTH_CONCURRENCY=5
USER_RATELIMIT_REDIS_TIMEOUT_MS=150
USER_RATELIMIT_MEMORY_MAX_ENTRIES=10000

# Search (docker qdrant + ollama)
QDRANT_CONTAINER=local-qdrant
QDRANT_EXT_PORT=6333
QDRANT_INT_PORT=6333
EMBEDDING_CONTAINER=local-embedding-service
EMBEDDING_EXT_PORT=11434
EMBEDDING_INT_PORT=11434
EMBEDDING_MODEL_INIT_CONTAINER=local-embedding-model-init

# AI (docker qdrant/ollama/postgres; LLM_MODE=real needs LIGHTNING_AI_API_KEY)
AI_SERVICE_CONTAINER=local-ai-service
AI_SERVICE_INT_PORT=50051
AI_SERVICE_EXT_PORT=50051
AI_METRICS_INT_PORT=12666
AI_METRICS_EXT_PORT=12666
AI_LLM_MODE=real
AI_LOG_LEVEL=DEBUG
AI_TIMEOUT_SECONDS=30
LIGHTNING_AI_API_KEY=
AI_LIGHTNING_MODEL=openai/gpt-5-nano
AI_LANGCHAIN_TRACING=false
AI_LANGCHAIN_API_KEY=
AI_LANGCHAIN_PROJECT=topos-ai
AI_EMBEDDING_MODE=ollama
AI_QDRANT_URL=http://qdrant:6333
AI_EMBEDDING_URL=http://embedding-service:11434
AI_EMBEDDING_MODEL=snowflake-arctic-embed2:568m
AI_QDRANT_VECTOR_SIZE=1024
AI_SEARCH_DENSE_SCORE_THRESHOLD=0.3
AI_OTLP_ENDPOINT=
AI_POSTGRES_EXT_PORT=5433
AI_POSTGRES_USER=ai_checkpointer
AI_POSTGRES_PASSWORD=ai_checkpointer_pass
AI_POSTGRES_DB=ai_checkpoints
AI_CHECKPOINT_DB_URL=postgresql://ai_checkpointer:ai_checkpointer_pass@user-postgres:5432/ai_checkpoints
AI_CHECKPOINT_DB_URL_MIGRATE=postgresql://ai_checkpointer:ai_checkpointer_pass@user-postgres:5432/ai_checkpoints
AI_CHECKPOINT_POOL_MIN_SIZE=1
AI_CHECKPOINT_POOL_MAX_SIZE=10

# Gateway
GATEWAY_CONTAINER=local-gateway
GATEWAY_INT_PORT=4000
GATEWAY_EXT_PORT=4000
# Local ships no OTLP collector; keep router tracing off to avoid export errors.
OTEL_TRACING_ENABLED=false

# Frontend
FRONTEND_CONTAINER=local-frontend
FRONTEND_INT_PORT=3000
FRONTEND_EXT_PORT=3000
VITE_ENV_TYPE=dev
VITE_GRAPHQL_URL=http://localhost:4000/graphql
VITE_BACKEND_URL=http://localhost:4000
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=

# Content dials AI over gRPC
AI_SERVICE_URL=ai-service:50051
