# Real AWS backend — S3 + DynamoDB lock. Provision the bucket/table out-of-band.
# For Floci, use local backend (default, no -backend-config).
#
# 1. Create the bucket/table once (outside this stack):
#    aws s3api create-bucket --bucket topos-tf-state --region ap-south-1 --create-bucket-configuration LocationConstraint=ap-south-1
#    aws s3api put-bucket-versioning --bucket topos-tf-state --versioning-configuration Status=Enabled
#    aws s3api put-bucket-encryption --bucket topos-tf-state --server-side-encryption-configuration 'Rules=[{ApplyServerSideEncryptionByDefault:{SSEAlgorithm=AES256}}]'
#    aws dynamodb create-table --table-name topos-tf-locks --attribute-definitions AttributeName=LockID,AttributeType=S --key-schema AttributeName=LockID,KeyType=HASH --billing-mode PAY_PER_REQUEST --region ap-south-1
#
# 2. Init with this file:
#    terraform init -backend-config=backend.hcl -reconfigure
#
# For Floci, just `terraform init` (local).

bucket         = "topos-tf-state"
key            = "topos/user/terraform.tfstate"
region         = "ap-south-1"
dynamodb_table = "topos-tf-locks"
encrypt        = true
